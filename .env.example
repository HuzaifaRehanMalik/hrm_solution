# ---------------------------------------------------------------------------
# Neon (Postgres) — the only service this site connects to
# ---------------------------------------------------------------------------
# Stores contact enquiries and page analytics.
#
# 1. Create a project at https://console.neon.tech
# 2. Copy the POOLED connection string (it contains "-pooler").
# 3. Copy this file to .env.local and paste it below.
# 4. Run: npm run db:init
#
# Without DATABASE_URL the site still builds and renders; the contact form
# shows a clear message instead of silently losing the enquiry.

DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
